/* ---------- Paleta ----------
   Negro:        #070707
   Gris metal:   #B8B5B0
   Gris medio:   #5A5A58
   Gris oscuro:  #2A2A2A
   Rojo sangre:  #D1121B
   Rojo alerta:  #FF2A2A
   Verde tóxico: #6FAE45
   Texto:        #C9C6C0
----------------------------- */

.root {
    flex-grow: 1;
    background-color: rgb(7, 7, 7);
}

.hidden { display: none; }

.fill {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

#VideoBackground { -unity-background-scale-mode: scale-and-crop; }
.video-shade { background-color: rgba(0, 0, 0, 0.30); }

.left-shade {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 55%;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---------- Logo Ajustado ---------- */
.logo {
    flex-shrink: 1;
    min-height: 180px; 
    margin-bottom: 50px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
}

.logo-emblem {
    width: 260px;
    height: 260px;
    background-image: url("project://database/Assets/UI/Logo2.png");
}

/* --- Estilos para el Ranking Local --- */
.ranking-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(7, 7, 7, 0.6);
    border-color: rgb(42, 42, 42);
    border-width: 1px;
    border-left-width: 4px;
    border-left-color: rgb(90, 90, 88);
    margin-bottom: 8px;
    padding: 10px 15px;
    transition-property: border-left-color, background-color;
    transition-duration: 0.15s;
}

.ranking-row:hover {
    border-left-color: rgb(111, 174, 69);
    background-color: rgba(111, 174, 69, 0.1);
}

.ranking-pos {
    color: rgb(111, 174, 69);
    font-size: 18px;
    -unity-font-style: bold;
    width: 40px;
}

.ranking-info {
    color: rgb(240, 238, 234);
    font-size: 16px;
    letter-spacing: 1px;
}

.ranking-empty {
    color: rgb(184, 181, 176);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 50px;
    -unity-font-style: italic;
}

.logo-wordmark {
    width: 500px;
    height: 180px;
    background-image: url("project://database/Assets/UI/LogoSinFondo1.png");
}

.logo-dim { opacity: 0.7; }

/* ---------- Columna izquierda Ajustada ---------- */
.left-column {
    position: absolute;
    left: 12%; 
    top: 0;
    bottom: 0;
    width: 550px; 
    justify-content: center;
}

.menu-container {
    flex-shrink: 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.menu-hidden {
    opacity: 0;
    translate: -40px 0;
}

/* ---------- Botones del menú Ajustados ---------- */
.btn-menu {
    height: 65px;
    margin: 0 0 12px 0;
    padding: 0 0 0 35px;
    -unity-text-align: middle-left;
    font-size: 32px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(214, 211, 205);
    background-color: rgba(10, 12, 13, 0.55);
    -unity-background-image-tint-color: rgba(209, 18, 27, 0);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-left-width: 4px;
    border-left-color: rgb(90, 90, 88);
    border-radius: 0;
    transition-property: -unity-background-image-tint-color, color, border-color, border-left-color, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.btn-menu:hover, .btn-menu:focus, .btn-menu.btn-active {
    -unity-background-image-tint-color: rgba(209, 18, 27, 0.75);
    border-color: rgba(209, 18, 27, 0.55);
    border-left-color: rgb(255, 42, 42);
    color: rgb(255, 255, 255);
    translate: 10px 0;
}

.btn-menu:active { -unity-background-image-tint-color: rgba(255, 42, 42, 0.95); }

.btn-menu:disabled, .btn-menu:disabled:hover {
    color: rgba(214, 211, 205, 0.28);
    -unity-background-image-tint-color: rgba(209, 18, 27, 0);
    border-color: rgba(255, 255, 255, 0.05);
    border-left-color: rgb(42, 42, 42);
    translate: 0 0;
}

/* ---------- Panel de cristal ---------- */
.side-panel {
    position: absolute;
    right: 7%;
    top: 50%;
    width: 560px;
    padding: 30px 38px 28px 38px;
    background-color: rgba(12, 15, 17, 0.80);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-top-width: 3px;
    border-top-color: rgb(209, 18, 27);
    border-radius: 6px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 -50%;
}

.side-panel.panel-wide { width: 720px; }

.panel-fade {
    opacity: 0;
    translate: 40px -50%;
}

.panel-title {
    color: rgb(240, 238, 234);
    font-size: 30px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgb(209, 18, 27);
}

.panel-subtitle {
    color: rgb(111, 174, 69);
    font-size: 15px;
    letter-spacing: 2px;
    margin-top: 4px;
}

.divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.12);
    margin-top: 16px;
    margin-bottom: 22px;
}

.panel-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* ---------- Botones del panel ---------- */
.btn-action {
    height: 46px;
    min-width: 150px;
    margin: 0 0 0 12px;
    padding: 0 22px;
    font-size: 17px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(201, 198, 192);
    background-color: rgba(7, 7, 7, 0.8);
    border-width: 1px;
    border-color: rgb(90, 90, 88);
    border-radius: 0;
    transition-property: background-color, color, border-color;
    transition-duration: 0.12s;
}

.btn-action:hover, .btn-action:focus {
    background-color: rgb(209, 18, 27);
    border-color: rgb(255, 42, 42);
    color: rgb(255, 255, 255);
}

.btn-action:active { background-color: rgb(120, 8, 14); }

.btn-action-primary { border-color: rgb(111, 174, 69); }
.btn-action-primary:hover, .btn-action-primary:focus {
    background-color: rgb(111, 174, 69);
    border-color: rgb(150, 210, 100);
    color: rgb(7, 7, 7);
}

.btn-action:disabled, .btn-action:disabled:hover {
    opacity: 0.35;
    color: rgb(201, 198, 192);
    background-color: rgba(7, 7, 7, 0.8);
    border-color: rgb(90, 90, 88);
}

/* ---------- Selección de personaje y Nombre ---------- */
.cards {
    flex-direction: row;
    margin-left: -8px;
    margin-right: -8px;
    margin-bottom: 14px;
}

.char-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 14px;
    background-color: rgba(7, 7, 7, 0.7);
    border-width: 2px;
    border-color: rgb(42, 42, 42);
    transition-property: background-color, border-color, translate;
    transition-duration: 0.15s;
}

.char-card:hover, .char-card:focus {
    border-color: rgb(184, 181, 176);
    translate: 0 -3px;
}

.char-card.card-selected {
    border-color: rgb(209, 18, 27);
    background-color: rgba(209, 18, 27, 0.18);
}

.char-portrait {
    height: 190px;
    flex-shrink: 0;
    margin-bottom: 14px;
    background-color: rgb(14, 15, 16);
    border-width: 1px;
    border-color: rgb(42, 42, 42);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.portrait-placeholder {
    color: rgb(42, 42, 42);
    font-size: 72px;
    -unity-font-style: bold;
}

.char-name {
    color: rgb(240, 238, 234);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.char-role {
    color: rgb(111, 174, 69);
    font-size: 14px;
    letter-spacing: 1px;
    margin-top: 4px;
    min-height: 40px;
    white-space: normal;
}

.input-hint {
    color: rgb(184, 181, 176);
    font-size: 14px;
    margin-top: -20px;
    margin-bottom: 20px;
    margin-left: 185px; /* Alineado con la caja de texto */
    -unity-font-style: italic;
}

/* Estado Inválido (Rojo) */
.input-invalid > .unity-text-field__input {
    border-color: rgb(209, 18, 27);
}
.input-invalid > .unity-text-field__input:focus {
    background-color: rgba(209, 18, 27, 0.15);
    border-width: 2px;
}

/* Estado Válido (Verde Tóxico) */
.input-valid > .unity-text-field__input {
    border-color: rgb(111, 174, 69);
}
.input-valid > .unity-text-field__input:focus {
    background-color: rgba(111, 174, 69, 0.15);
    border-width: 2px;
}

/* --- Input del Nombre del Jugador --- */
.player-name-input {
    margin-top: 10px;
    margin-bottom: 25px;
    color: rgb(240, 238, 234);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.player-name-input > .unity-label {
    color: rgb(111, 174, 69);
    min-width: 180px;
}

.player-name-input > .unity-text-field__input {
    background-color: rgba(7, 7, 7, 0.8);
    border-color: rgb(90, 90, 88);
    border-width: 1px;
    padding: 8px 12px;
    border-radius: 0;
}

.player-name-input > .unity-text-field__input:focus {
    border-color: rgb(209, 18, 27);
    background-color: rgba(209, 18, 27, 0.1);
}

/* --- Feedback de interacción para el Input de Nombre --- */

/* Cuando pasas el ratón por encima (Hover) */
.player-name-input > .unity-text-field__input:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgb(184, 181, 176);
}

/* Cuando el elemento tiene el foco (Mando o Ratón seleccionado) */
.player-name-input > .unity-text-field__input:focus {
    background-color: rgba(209, 18, 27, 0.15); /* Fondo rojo sutil */
    border-color: rgb(209, 18, 27);          /* Borde rojo brillante */
    border-width: 2px;
}

/* ---------- Opciones ---------- */
.settings-content { margin-bottom: 4px; }
.slider-block { margin-bottom: 20px; }

.row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.row-label {
    color: rgb(201, 198, 192);
    font-size: 15px;
    letter-spacing: 3px;
}

.row-value {
    color: rgb(111, 174, 69);
    font-size: 15px;
    -unity-font-style: bold;
}

.volume-slider { margin: 0; }
.volume-slider:focus .unity-base-slider__dragger { border-color: rgb(111, 174, 69); }

.volume-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: rgb(42, 42, 42);
    border-width: 2px;
    border-color: rgb(7, 7, 7);
    border-radius: 0;
}

.volume-slider .unity-base-slider__dragger {
    width: 16px;
    height: 20px;
    background-color: rgb(209, 18, 27);
    border-width: 2px;
    border-color: rgb(255, 42, 42);
    border-radius: 0;
}

.volume-slider .unity-base-slider__dragger:hover {
    background-color: rgb(255, 42, 42);
}

/* ---------- Marco HUD ---------- */
.hud-corner {
    position: absolute; width: 220px; height: 130px; border-color: rgb(90, 90, 88);
}
.hud-corner-inner {
    position: absolute; top: 10px; left: 10px; right: 10px; bottom: 10px; border-color: rgb(209, 18, 27);
}

.corner-tl { top: 24px; left: 24px; border-top-width: 5px; border-left-width: 5px; }
.corner-tl .hud-corner-inner { border-top-width: 2px; border-left-width: 2px; }
.corner-tr { top: 24px; right: 24px; border-top-width: 5px; border-right-width: 5px; }
.corner-tr .hud-corner-inner { border-top-width: 2px; border-right-width: 2px; }
.corner-bl { bottom: 24px; left: 24px; border-bottom-width: 5px; border-left-width: 5px; }
.corner-bl .hud-corner-inner { border-bottom-width: 2px; border-left-width: 2px; }
.corner-br { bottom: 24px; right: 24px; border-bottom-width: 5px; border-right-width: 5px; }
.corner-br .hud-corner-inner { border-bottom-width: 2px; border-right-width: 2px; }

.footer-left { position: absolute; left: 70px; bottom: 38px; flex-direction: row; }
.footer-right { position: absolute; right: 70px; bottom: 38px; }
.footer-text { color: rgba(201, 198, 192, 0.45); font-size: 16px; letter-spacing: 2px; margin-right: 36px; }
.footer-ok { color: rgb(111, 174, 69); margin-right: 0; }