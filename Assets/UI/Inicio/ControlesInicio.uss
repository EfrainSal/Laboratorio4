.inicio-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(226, 228, 223); }
.intro-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(1, 5, 8, 0.84); }
.intro-panel { width: 1190px; max-width: 94%; padding: 32px 42px 30px 42px; background-color: rgb(12, 17, 21); border-width: 1px; border-color: rgb(64, 76, 82); border-top-width: 4px; border-top-color: rgb(190, 45, 51); }
.intro-header { flex-direction: row; align-items: center; margin-bottom: 16px; }
.intro-insignia { width: 70px; height: 70px; background-color: rgb(124, 25, 32); border-width: 1px; border-color: rgb(210, 63, 67); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 29px; margin-right: 22px; }
.intro-titulos { flex-grow: 1; }
.intro-kicker { color: rgb(180, 149, 135); font-size: 14px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 6px; }
.intro-title { font-size: 40px; -unity-font-style: bold; color: rgb(240, 239, 231); }
.intro-subtitle { font-size: 18px; color: rgb(157, 174, 181); margin-bottom: 26px; }
.intro-columns { flex-direction: row; margin-bottom: 18px; }
.intro-column { flex-grow: 1; flex-basis: 0; }
.intro-column-left { margin-right: 36px; }
.intro-section { font-size: 14px; -unity-font-style: bold; color: rgb(126, 149, 158); letter-spacing: 1px; margin-bottom: 9px; }
.control-row { flex-direction: row; align-items: center; justify-content: space-between; height: 53px; border-bottom-width: 1px; border-bottom-color: rgb(33, 44, 51); }
.control-name { font-size: 19px; color: rgb(217, 222, 218); }
.control-key { min-width: 78px; max-width: 245px; padding: 8px 12px; margin-left: 8px; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; background-color: rgb(28, 38, 45); border-width: 1px; border-bottom-width: 3px; border-color: rgb(64, 81, 91); color: rgb(229, 235, 232); }
.intro-mission { flex-direction: row; align-items: center; padding: 16px 18px; background-color: rgb(18, 32, 34); border-left-width: 3px; border-left-color: rgb(100, 174, 149); margin-bottom: 23px; }
.intro-card-icon { width: 88px; height: 58px; margin-right: 19px; }
.intro-mission-copy { flex-grow: 1; }
.intro-objective { font-size: 20px; color: rgb(214, 233, 222); margin-bottom: 5px; white-space: normal; }
.intro-hint { font-size: 15px; color: rgb(147, 166, 174); white-space: normal; }
.intro-footer { flex-direction: row; align-items: center; justify-content: space-between; }
.intro-continue { min-width: 560px; margin: 0; }
.recepcion-objetivo { position: absolute; bottom: 27px; align-self: center; padding: 13px 24px; background-color: rgba(7, 19, 23, 0.94); border-left-width: 3px; border-left-color: rgb(111, 179, 151); }
.recepcion-objetivo-texto { color: rgb(223, 236, 226); font-size: 18px; -unity-font-style: bold; }
